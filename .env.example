# SmartHire configuration — every environment variable the project reads.
#
# Copy to .env at the repo root:  cp .env.example .env
# Docker Compose reads .env automatically and hands it to every backend container.
# .env is gitignored; this file is committed as documentation. Every value below is the
# default, so the stack also runs with no .env at all.

# --- Postgres -----------------------------------------------------------------------
# Used by the db container to create the database, and by the backend to connect to it.
POSTGRES_USER=smarthire
POSTGRES_PASSWORD=smarthire
POSTGRES_DB=smarthire
# Where the backend finds Postgres. Compose overrides these to db:5432 inside its network;
# they matter when you run uvicorn or pytest on your own machine.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL, when set, replaces all five values above with one connection string.
# Leave it unset here: inside Compose it would override the "db" host.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# --- Connection pool (per backend process) ------------------------------------------
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=-1

# --- Application --------------------------------------------------------------------
APP_NAME=SmartHire API
# local | docker | test | production. Compose sets docker.
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Business rules -----------------------------------------------------------------
MAX_APPLICATIONS_PER_CANDIDATE=10
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Ports published on your machine (Compose only) ---------------------------------
DB_HOST_PORT=5432
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# --- Frontend (Compose only) --------------------------------------------------------
# Where nginx proxies /api. Change it to point the console at another API.
API_UPSTREAM=http://api:8000

# --- Tests --------------------------------------------------------------------------
# The suite creates this database on the same server, and drops it afterwards.
TEST_DATABASE_NAME=smarthire_test
