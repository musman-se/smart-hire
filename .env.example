# SmartHire configuration — every environment variable the project reads.
#
# Copy to .env at the repo root:  cp .env.example .env
# Docker Compose reads .env automatically and hands it to every backend container.
# .env is gitignored; this file is committed as documentation. Every value below is the
# default, except POSTGRES_PASSWORD: it has no default in code, so .env is required.

# --- Postgres -----------------------------------------------------------------------
# Used by the db container to create the database, and by the backend to connect to it.
POSTGRES_USER=smarthire
# Required — the code has no default. This value is for local development only.
POSTGRES_PASSWORD=smarthire
POSTGRES_DB=smarthire
# Where the backend finds Postgres. Compose overrides these to db:5432 inside its network;
# they matter when you run uvicorn or pytest on your own machine.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL, when set, replaces all five values above with one connection string.
# Leave it unset here: inside Compose it would override the "db" host.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# --- Connection pool (per backend process) ------------------------------------------
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=-1

# --- Application --------------------------------------------------------------------
APP_NAME=SmartHire API
# local | docker | test | production. Compose sets docker. Logged at startup;
# production refuses to start with PUBLISHING_FAULT_RATE above 0.
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Temporal (workflow orchestration) ----------------------------------------------
# Compose overrides the address to temporal:7233 inside its network.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=smarthire

# --- Redis --------------------------------------------------------------------------
# Compose overrides the host to redis inside its network.
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=1.0
# Idempotency keys: how long a response is kept for replay, and how long an
# in-progress claim survives a crashed request.
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_LOCK_SECONDS=60

# --- Publishing workflow ------------------------------------------------------------
# Attempts per activity before a publish is marked failed.
PUBLISHING_MAX_ATTEMPTS=5
# Fraction of activity attempts that fail on purpose (0..1), to watch retries in the
# Temporal UI. Keep at 0 outside a demo.
PUBLISHING_FAULT_RATE=0

# --- Worker -------------------------------------------------------------------------
# Seconds running activities get to finish after SIGTERM. Keep below the Compose
# stop_grace_period (30s).
WORKER_SHUTDOWN_GRACE_SECONDS=20

# --- Application processing workflow ------------------------------------------------
APPLICATION_PROCESSING_MAX_ATTEMPTS=5

# --- Business rules -----------------------------------------------------------------
MAX_APPLICATIONS_PER_CANDIDATE=10
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Ports published on your machine (Compose only) ---------------------------------
DB_HOST_PORT=5432
API_HOST_PORT=8000
WEB_HOST_PORT=3000
TEMPORAL_HOST_PORT=7233
TEMPORAL_UI_HOST_PORT=8233
REDIS_HOST_PORT=6379

# --- Read elsewhere, not from this file -----------------------------------------------
# The seed script reads SMARTHIRE_API_URL (Compose sets it for the seed service).
# The console reads two build-time variables from frontend/.env — Vite does not see this
# file: VITE_API_URL (default /api) and VITE_TEMPORAL_UI_URL (default
# http://localhost:8233; the console assumes the "default" namespace).

# --- Frontend (Compose only) --------------------------------------------------------
# Where nginx proxies /api. Change it to point the console at another API.
API_UPSTREAM=http://api:8000

# --- Tests --------------------------------------------------------------------------
# The suite creates this database on the same server if missing, and drops its tables
# afterwards.
TEST_DATABASE_NAME=smarthire_test
# Redis logical database the suite uses — never the one the app uses.
TEST_REDIS_URL=redis://localhost:6379/15
