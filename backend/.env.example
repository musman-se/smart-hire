# Copy to .env and adjust. .env is gitignored; this file is committed as documentation.

# --- Postgres container ---
POSTGRES_USER=smarthire
POSTGRES_PASSWORD=smarthire
POSTGRES_DB=smarthire

# --- Application ---
ENVIRONMENT=local

# Connection string used when you run uvicorn on your own machine.
# Inside Docker Compose the api service overrides this with host "db" instead of "localhost",
# because containers reach each other by service name, not through your machine's network.
DATABASE_URL=postgresql+asyncpg://smarthire:smarthire@localhost:5432/smarthire
